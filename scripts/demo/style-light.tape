Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1300
Set Padding 20
Set Margin 30
Set MarginFill "#ffffff"
Set BorderRadius 12
Set WindowBar Colorful
Set WindowBarSize 36
Set TypingSpeed 35ms
Set Theme { "background": "#ffffff", "foreground": "#3b3b3b", "black": "#000000", "red": "#cd3131", "green": "#107c10", "yellow": "#949800", "blue": "#0451a5", "magenta": "#bc05bc", "cyan": "#0598bc", "white": "#555555", "brightBlack": "#666666", "brightRed": "#cd3131", "brightGreen": "#14ce14", "brightYellow": "#b5ba00", "brightBlue": "#0451a5", "brightMagenta": "#bc05bc", "brightCyan": "#0598bc", "brightWhite": "#a5a5a5", "cursor": "#3b3b3b", "selection": "#add6ff" }
