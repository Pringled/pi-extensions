Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1300
Set Padding 20
Set Margin 30
Set MarginFill "#0d1117"
Set BorderRadius 12
Set WindowBar Colorful
Set WindowBarSize 36
Set TypingSpeed 35ms
Set Theme { "background": "#1e1e1e", "foreground": "#d4d4d4", "black": "#1e1e1e", "red": "#f14c4c", "green": "#23d18b", "yellow": "#f5f543", "blue": "#3b8eea", "magenta": "#d670d6", "cyan": "#29b8db", "white": "#e5e5e5", "brightBlack": "#666666", "brightRed": "#f14c4c", "brightGreen": "#23d18b", "brightYellow": "#f5f543", "brightBlue": "#3b8eea", "brightMagenta": "#d670d6", "brightCyan": "#29b8db", "brightWhite": "#e5e5e5", "cursor": "#d4d4d4", "selection": "#264f78" }
